\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces TT-SNR-map resulting from injected BNS non-spinning superimposed signals\relax }}{11}{figure.caption.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Example of a NSBH ($1.4 - 25 M_\odot $) waveform including higher-order modes, injected with inclination $\iota = \frac  {\pi }{2}$. The TT-SNR MAP shows a clear modification of the central region, where the sharp rectangular features typically present in the standard representation are smoothed out by the contribution of higher-order modes. A similar structure is also visible at lower amplitudes, repeating regularly at later times.\relax }}{11}{figure.caption.21}\protected@file@percent }
\newlabel{fig:HM}{{10}{11}{Example of a NSBH ($1.4 - 25 M_\odot $) waveform including higher-order modes, injected with inclination $\iota = \frac {\pi }{2}$. The TT-SNR MAP shows a clear modification of the central region, where the sharp rectangular features typically present in the standard representation are smoothed out by the contribution of higher-order modes. A similar structure is also visible at lower amplitudes, repeating regularly at later times.\relax }{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces TT-SNR MAP of precessing NSBH system ($1.4 - 25M_\odot $) injected with inclination $\iota = \frac  {\pi }{2}$. The effect of spin-induced precession manifests as a modulation of the TT-SNR MAP structure, producing beam-like features radiating from the center of the map. These patterns reflect the time-dependent orbital-plane precession imprinted on the signal morphology.\relax }}{11}{figure.caption.22}\protected@file@percent }
\newlabel{fig:Precessing}{{11}{11}{TT-SNR MAP of precessing NSBH system ($1.4 - 25M_\odot $) injected with inclination $\iota = \frac {\pi }{2}$. The effect of spin-induced precession manifests as a modulation of the TT-SNR MAP structure, producing beam-like features radiating from the center of the map. These patterns reflect the time-dependent orbital-plane precession imprinted on the signal morphology.\relax }{figure.caption.22}{}}
\citation{Gamboa_2025}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Representative example illustrating the effect of eccentricity in the TT-SNR MAP. Here it is shown a $1.4 - 6M_\odot $ non spinning system with $e = 0.3$. The imprint of eccentricity is clearly visible as a repeating structure beneath the main TT-SNR MAP pattern, appearing twice and introducing distinctive features associated with the non-circular orbital dynamics. \relax }}{12}{figure.caption.23}\protected@file@percent }
\newlabel{fig:Eccentricity}{{12}{12}{Representative example illustrating the effect of eccentricity in the TT-SNR MAP. Here it is shown a $1.4 - 6M_\odot $ non spinning system with $e = 0.3$. The imprint of eccentricity is clearly visible as a repeating structure beneath the main TT-SNR MAP pattern, appearing twice and introducing distinctive features associated with the non-circular orbital dynamics. \relax }{figure.caption.23}{}}
