\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces BNS spinning ($\chi _1^{z} = \chi _2^{z} = 0.5$; $1.4 - 1.4\,M_\odot $) signal. The TT-SNR MAP shows the presence of spin by this ``rounding`` angle effect in the lower-left of the butterfly structure.\relax }}{10}{figure.caption.19}\protected@file@percent }
\newlabel{fig:Extreme_spin}{{8}{10}{BNS spinning ($\chi _1^{z} = \chi _2^{z} = 0.5$; $1.4 - 1.4\,M_\odot $) signal. The TT-SNR MAP shows the presence of spin by this ``rounding`` angle effect in the lower-left of the butterfly structure.\relax }{figure.caption.19}{}}
\citation{PhysRev.131.435,PhysRev.136.B1224}
\newlabel{fig:superimposed-axis}{{9a}{11}{BNS non-spinning ($1.4 - 1.4\,M_\odot $) superimposed signals. The TT-SNR MAP clearly encodes the presence of two signals that are closely separated in time and nearly identical in parameter space. An interference-like pattern emerges from the superposition of the signal representations produced by the template-based SNR time series, highlighting the TT-SNR MAP's ability to capture overlapping events.\relax }{figure.caption.20}{}}
\newlabel{sub@fig:superimposed-axis}{{a}{11}{BNS non-spinning ($1.4 - 1.4\,M_\odot $) superimposed signals. The TT-SNR MAP clearly encodes the presence of two signals that are closely separated in time and nearly identical in parameter space. An interference-like pattern emerges from the superposition of the signal representations produced by the template-based SNR time series, highlighting the TT-SNR MAP's ability to capture overlapping events.\relax }{figure.caption.20}{}}
\newlabel{fig:superimposed-zoom}{{9b}{11}{BNS non-spinning ($1.4 - 1.4\,M_\odot $) superimposed signals, zoomed view around the merging time.\relax }{figure.caption.20}{}}
